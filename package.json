{
  "name": "@yiliang114/dsh-session-deck",
  "version": "0.1.9",
  "license": "MIT",
  "author": "yiliang114",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": ["dsh-plugin", "deepseek-harness", "sidebar", "sessions", "session-management", "session-navigation", "activity-view", "workspaces", "favorites", "ai-agents", "codex-inspired"],
  "type": "module",
  "description": "Codex-inspired activity and session management for DeepSeek Harness: track running, waiting, and unread sessions across workspaces.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yiliang114/dsh-session-deck.git"
  },
  "homepage": "https://github.com/yiliang114/dsh-session-deck#readme",
  "bugs": {
    "url": "https://github.com/yiliang114/dsh-session-deck/issues"
  },
  "engines": {
    "node": ">=22",
    "dsh": "0.2.1-rc.2"
  },
  "exports": {
    ".": "./src/host.mjs",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["src", "lib", "scripts/patch-sidebar-before.mjs", "cordis.patch.yml", "README.md"],
  "scripts": {
    "build": "node --check src/host.mjs && node --check lib/client.js && node --check scripts/patch-sidebar-before.mjs && node --check scripts/check-package.mjs && node --check scripts/update-market-index.mjs && node --check scripts/verify-published.mjs && node --check scripts/auto-release.mjs",
    "market:update": "node scripts/update-market-index.mjs",
    "test": "node --test test/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "verify": "npm run build && npm test && npm run check:package"
  },
  "dsh": {
    "bundle": {"patch": "./cordis.patch.yml"},
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  }
}
